# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/digital_heroes
# Long random string. REQUIRED in production (server refuses to start without it)
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Allowed browser origin(s), comma separated. Set to your deployed frontend URL in production
CLIENT_URL=http://localhost:5173
PORT=5000
# demo = simulated payments (default). A stripe provider can be added in services/paymentProvider.js
PAYMENT_PROVIDER=demo
# Only needed if you add Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
